# Program 1: Simple Calculator
num1 = 20
num2 = 5
operators = ["+", "-", "*", "/"]

print("---- Simple Calculator ----")
for operator in operators:
    if operator == "+":
        result = num1 + num2
    elif operator == "-":
        result = num1 - num2
    elif operator == "*":
        result = num1 * num2
    elif operator == "/":
        result = num1 / num2
    else:
        result = "Invalid operator"
    print(f"{num1} {operator} {num2} = {result}")
